{
  "name": "alfred-winner-services",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "next dev -p 3100",
    "build": "next build",
    "preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
    "deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
    "upload": "opennextjs-cloudflare build && opennextjs-cloudflare upload",
    "start": "next start -p 3100",
    "lint": "eslint",
    "typecheck": "next typegen && tsc --noEmit",
    "images:prepare": "node scripts/prepare-images.mjs",
    "test:gmail-api": "node --test scripts/test-gmail-api.mjs",
    "test": "node --test scripts/test-gmail-api.mjs scripts/test-contact-route.mjs scripts/test-cloudflare-worker.mjs scripts/test-site-contracts.mjs",
    "test:e2e": "playwright test",
    "build:cloudflare": "opennextjs-cloudflare build",
    "check": "npm run lint && npm run typecheck && npm test && npm run build:qa && npm run test:e2e",
    "build:qa": "node scripts/build-qa.mjs"
  },
  "dependencies": {
    "@opennextjs/cloudflare": "^1.20.12",
    "next": "^16.4.2",
    "nodemailer": "^10.0.10",
    "react": "19.2.8",
    "react-dom": "19.2.8"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.14.0",
    "@playwright/test": "^1.64.1",
    "@tailwindcss/postcss": "^4",
    "@types/node": "^20",
    "@types/nodemailer": "^8.0.2",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "^16.4.2",
    "tailwindcss": "^4",
    "typescript": "^5",
    "wrangler": "^4.151.1"
  },
  "overrides": {
    "miniflare": {
      "undici": "^7.30.1"
    },
    "@node-minify/core": {
      "glob": "^10.5.0"
    }
  }
}
